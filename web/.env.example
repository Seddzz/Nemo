# Base URL of the FastAPI backend, reachable from the browser.
# Example: https://anonymizer-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only secret used by /api/chat to call Groq.
# Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Groq chat model id (default: openai/gpt-oss-120b).
GROQ_MODEL=
